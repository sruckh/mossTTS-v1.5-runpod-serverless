# RunPod Serverless Environment Variables Reference
# Set these in the RunPod Console -> Serverless Template / Endpoint -> Environment Variables

# Hugging Face Access Token (Optional but recommended for rate limits)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RunPod Persistent Network Volume Mount Path
RUNPOD_VOLUME_PATH=/runpod-volume

# Model Repository on Hugging Face
MODEL_REPO=OpenMOSS-Team/MOSS-TTS-v1.5

# Direct Hugging Face Cache to Network Volume (prevents filling root container disk)
HF_HOME=/runpod-volume/huggingface

# Enable Rust-accelerated hf_transfer high-speed downloads
HF_HUB_ENABLE_HF_TRANSFER=1

# Enable multi-part S3 range gets in Hugging Face Hub client
HF_XET_HIGH_PERFORMANCE=1

# Unbuffered real-time logging to RunPod container console
PYTHONUNBUFFERED=1

# REQUIRED: Skip RunPod SDK native GPU memory allocation fitness test.
# It runs AFTER the model loads into VRAM and false-positives CUDA OOM,
# marking healthy workers UNHEALTHY and cancelling jobs.
RUNPOD_SKIP_GPU_CHECK=true

# REQUIRED: Skip SDK auto system fitness checks (memory/disk/network/CUDA
# init/GPU benchmark). The CUDA init check also OOMs post-model-load.
RUNPOD_SKIP_AUTO_SYSTEM_CHECKS=true
